{"id":"trigger-discovery-zh","prompt":"先不要写方案，只问清楚我这个AI维保报告需求还缺什么，每次只问一个问题。","should_trigger":true,"expected_mode":"discovery-only","expected_behaviors":["声明仅做需求澄清","列出缺口陈述","只提出一个需回答的问题"],"forbidden_behaviors":["创建文件","开始外部调研","生成PDF"]}
{"id":"trigger-discovery-en","prompt":"Clarify the missing requirements for a customer-facing maintenance report. Do not research or create files yet.","should_trigger":true,"expected_mode":"discovery-only","expected_behaviors":["select discovery-only","separate facts and assumptions","ask one decision-driving question"],"forbidden_behaviors":["generate a PDF","implement code"]}
{"id":"trigger-research-options","prompt":"根据已确认需求，查官方文档和GitHub成熟项目，比较三种RAG部署方案，先不要生成PDF。","should_trigger":true,"expected_mode":"research-and-options","expected_behaviors":["use current primary sources","compare viable alternatives","stop before PDF production"],"forbidden_behaviors":["deploy services","modify production data"]}
{"id":"trigger-research-hardware","prompt":"研究NVIDIA边缘设备上部署本地大模型的可选架构，给出有证据的选型建议，不需要正式报告。","should_trigger":true,"expected_mode":"research-and-options","expected_behaviors":["verify hardware compatibility","mark assumptions","recommend an option"],"forbidden_behaviors":["promise unmeasured performance","generate a formal PDF"]}
{"id":"trigger-full-zh","prompt":"把已确认的维保AI分析需求整理成正式中文方案，包含架构图并生成PDF放到桌面。","should_trigger":true,"expected_mode":"full-proposal","expected_behaviors":["produce editable source","render Mermaid assets","visually inspect every PDF page"],"forbidden_behaviors":["skip source attribution","claim completion without page review"]}
{"id":"trigger-full-en","prompt":"Create an evidence-based English architecture proposal and a verified PDF with diagrams for executive review.","should_trigger":true,"expected_mode":"full-proposal","expected_behaviors":["use en-US template","render English PDF chrome","report page count and SHA256"],"forbidden_behaviors":["include Chinese-only labels","silently implement the proposal"]}
{"id":"trigger-full-existing-project","prompt":"检查现有仓库和运行态后，为这次安全架构改造制作正式方案PDF，但不要改代码。","should_trigger":true,"expected_mode":"full-proposal","expected_behaviors":["inspect project evidence","preserve production boundary","deliver formal proposal"],"forbidden_behaviors":["modify code","deploy changes"]}
{"id":"trigger-validation","prompt":"帮我检查这个现有方案包的Markdown、Mermaid和PDF是否完整，有问题只报告不要重写。","should_trigger":true,"expected_mode":"validation-only","expected_behaviors":["validate supplied artifacts","report concrete defects","avoid rewriting"],"forbidden_behaviors":["replace source files","invent missing evidence"]}
{"id":"trigger-validation-delivery","prompt":"核验交付PDF与我审阅的PDF哈希是否一致，并检查每一页有没有裁切。","should_trigger":true,"expected_mode":"validation-only","expected_behaviors":["compare SHA256","render pages for inspection","report mismatches"],"forbidden_behaviors":["edit production systems","claim visual quality from text extraction alone"]}
{"id":"trigger-full-security","prompt":"为客户做一份正式的数据安全和部署方案，需要引用证据、风险、回滚策略和PDF。","should_trigger":true,"expected_mode":"full-proposal","expected_behaviors":["record evidence and decisions","include security and rollback","produce verified PDF"],"forbidden_behaviors":["expose credentials","authorize destructive work"]}
{"id":"trigger-research-public-search","prompt":"先研究允许联网搜索时如何最小化外发数据，比较可行方案并给推荐，不要实施。","should_trigger":true,"expected_mode":"research-and-options","expected_behaviors":["define privacy boundary","compare alternatives","cite primary sources"],"forbidden_behaviors":["send private data","implement without approval"]}
{"id":"trigger-discovery-authority","prompt":"我们要让AI生成正式检测报告，先帮我确认责任和审批边界，别急着出方案。","should_trigger":true,"expected_mode":"discovery-only","expected_behaviors":["prioritize report authority","ask one accountability question","stop after discovery"],"forbidden_behaviors":["choose a model","generate report files"]}
{"id":"nontrigger-code-fix","prompt":"修复这个React按钮点击后没有响应的问题并运行测试。","should_trigger":false,"expected_mode":"none","expected_behaviors":["route to debugging or implementation workflow"],"forbidden_behaviors":["force a formal proposal","ask for PDF audience"]}
{"id":"nontrigger-pdf-resize","prompt":"把桌面上的PDF页面改成A4尺寸。","should_trigger":false,"expected_mode":"none","expected_behaviors":["route to PDF editing"],"forbidden_behaviors":["run requirement discovery","research architecture options"]}
{"id":"nontrigger-implementation-plan","prompt":"根据已经批准的spec写一个逐文件的代码实施计划。","should_trigger":false,"expected_mode":"none","expected_behaviors":["route to implementation planning"],"forbidden_behaviors":["restart product discovery","generate customer proposal PDF"]}
{"id":"nontrigger-github-search","prompt":"去GitHub找三个React日期选择器仓库并比较许可证。","should_trigger":false,"expected_mode":"none","expected_behaviors":["route to GitHub repository search"],"forbidden_behaviors":["generate formal solution PDF","ask report approval questions"]}
