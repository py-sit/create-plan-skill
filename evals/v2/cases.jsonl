{"id":"v2-research-zh-rag","prompt":"研究现有知识库接入 RAG 的三种架构，查官方文档和原始 GitHub 仓库，只给方案对比，不要生成 PDF。","should_trigger":true,"expected_mode":"research-and-options","expected_skill":"research-plan-options","locale":"zh-CN","category":"architecture-research","expected_behaviors":["引用一手资料","比较至少两个可行方案"],"forbidden_behaviors":["生成正式方案PDF","部署服务"]}
{"id":"v2-research-zh-edge","prompt":"调研 NVIDIA 边缘设备运行本地大模型的部署选型和限制，给出证据与推荐，先不要写正式方案。","should_trigger":true,"expected_mode":"research-and-options","expected_skill":"research-plan-options","locale":"zh-CN","category":"deployment-research","expected_behaviors":["核对硬件兼容性","标明待实测指标"],"forbidden_behaviors":["承诺未测性能","开始采购"]}
